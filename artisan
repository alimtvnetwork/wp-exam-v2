#!/usr/bin/env php
<?php

declare(strict_types=1);

define('LARAVEL_START', microtime(true));

// Load Composer autoloader or fallback bootstrap
$autoloader = __DIR__ . '/vendor/autoload.php';

if (file_exists($autoloader)) {
    require_once $autoloader;
}

require_once __DIR__ . '/tests/bootstrap.php';

use App\Routing\Route;
use App\Services\Forms\FormJsonService;
use App\Models\Forms\Form;
use App\Models\Forms\FormSection;
use App\Models\Forms\FormField;

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? 'list';

switch ($command) {
    case 'test':
        echo "\n\033[1;32m  LARAVEL TEST RUNNER \033[0m - WP Exam & Universal Form Engine\n";
        echo "  " . str_repeat('─', 60) . "\n\n";

        $phpunitBinary = __DIR__ . '/vendor/bin/phpunit';

        if (file_exists($phpunitBinary)) {
            $passthruArgs = array_slice($argv, 2);
            $extraArgs = implode(' ', array_map('escapeshellarg', $passthruArgs));
            $cmd = "php " . escapeshellarg($phpunitBinary) . ($extraArgs ? " {$extraArgs}" : "");
            passthru($cmd, $exitCode);
            exit($exitCode);
        }

        require_once __DIR__ . '/tests/run-tests.php';
        exit(0);

    case 'route:list':
        echo "\n\033[1;34m  WP Exam Registered Laravel API Routes\033[0m\n";
        echo "  " . str_repeat('─', 80) . "\n";
        printf("  %-10s %-40s %-30s\n", 'Method', 'URI', 'Action');
        echo "  " . str_repeat('─', 80) . "\n";

        Route::loadRoutes();
        $routes = Route::getRoutes();

        foreach ($routes as $route) {
            $actionStr = is_array($route['action'])
                ? basename(str_replace('\\', '/', $route['action'][0])) . '@' . $route['action'][1]
                : 'Closure';

            printf("  \033[1;33m%-10s\033[0m %-40s \033[0;36m%-30s\033[0m\n", $route['method'], $route['uri'], $actionStr);
        }

        echo "  " . str_repeat('─', 80) . "\n\n";
        exit(0);

    case 'forms:export':
        $formId = (int) ($argv[2] ?? 1);
        $sampleForm = new Form([
            'FormId' => $formId,
            'Slug' => 'intern-programmer',
            'Title' => 'Intern Programmer Application',
            'ThemeId' => 'riseup-asia',
        ]);
        $section = new FormSection([
            'FormSectionId' => 1,
            'StepOrder' => 1,
            'Title' => 'Personal Information',
        ]);
        $field = new FormField([
            'FormFieldId' => 1,
            'FieldKey' => 'full_name',
            'FieldType' => 'text',
            'Label' => 'Full Name',
            'IsRequired' => 1,
        ]);
        $section->addField($field);
        $sampleForm->addSection($section);

        $jsonService = new FormJsonService();
        $json = $jsonService->exportToJson($sampleForm);
        echo $json . "\n";
        exit(0);

    case 'forms:list':
        echo "\n\033[1;32m  Available Form Schemas\033[0m\n";
        echo "  - job-application (Intern Programmer Application - 4-step DAG wizard)\n";
        echo "  - intern-programmer (Developers Organism Reference Form)\n\n";
        exit(0);

    case 'help':
    case 'list':
    default:
        echo "\n\033[1;32mWP Exam Laravel Console Engine\033[0m (Laravel 11.x Compatible)\n\n";
        echo "\033[1;33mUsage:\033[0m\n";
        echo "  php artisan [command] [options]\n\n";
        echo "\033[1;33mAvailable commands:\033[0m\n";
        echo "  \033[1;32mtest\033[0m                  Run the full PHPUnit and Feature test suite\n";
        echo "  \033[1;32mroute:list\033[0m            List all registered REST API routes\n";
        echo "  \033[1;32mforms:list\033[0m            List active form schemas and wizards\n";
        echo "  \033[1;32mforms:export {id}\033[0m     Export form definition to JSON format\n";
        echo "\n";
        exit(0);
}
